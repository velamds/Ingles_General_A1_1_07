er", "contents": [{"content": " These are words you use when you talk about sports equipment.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "jersey", "type": "name"}, {"content": "shirt for sports", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This jersey is perfect for you.", "type": "example"}, {"content": "engenn2le07ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "shorts", "type": "name"}, {"content": "short pants, often used for sports", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to get some shorts for the gym.", "type": "example"}, {"content": "engenn2le07ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bicycle", "type": "name"}, {"content": "a two-wheel vehicle you move by turning your legs", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want to buy a new bicycle. ", "type": "example"}, {"content": "engenn2le07ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "reflector light", "type": "name"}, {"content": "mirrors  or lights placed on a bicycle for safety", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You should buy reflector lights for the bicycle.", "type": "example"}, {"content": "engenn2le07ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to cycle ", "type": "name"}, {"content": "to ride a bicycle", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": " Example: I cycle in the summer. ", "type": "example"}, {"content": "engenn2le07ob05aud06", "type": "audio"}]}, {"content": "engenn2le07ob05re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Ask 6 people about the difference between American football and soccer.", "type": "text"}, {"conte