: [{"type": "text", "content": "Do you like shopping? What are the good things about shopping? What are the bad\nthings?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment. "}]}], "template_override": 1}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "At the Clothing Store"}, {"type": "unit_name", "content": "Everyone Loves Shopping"}, {"type": "position", "content": 1}, {"type": "origin", "content": "scholar > City Shoppers > A New Coat"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people, their likes and dislikes, homes or countries in communicative situations."}, {"type": "secondary_1", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_4", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_7", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_8", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Types of Stores"}, {"type": "describer", "content": "Stores are places you buy things. There are many different types of stores. Different countries have different types of stores.<br/><br/><span class = \"strong\">In Europe, many stores are often <span class = \"italic\">specialized</span> -- they sell a small number of things:</span><br/><br/>bakery - bread<br/>pastry shop - pastries<br/>pharmacy (drugstore) - medication<br/>perfumery - perfume<br/>butcher shop - meat<br/><br/><span class = \"strong\">In North America, stores are more <span class = \"italic\">generalized</span> - they sell many things:</span><br/><br/>grocery store - fruits, vegetables, meat, bread, etc.<br/>supermarket - a large grocery store<br/>convenience store (corner store) - milk, bread, candy, newspapers, etc. <br/>hardware store - nails, tools, cleaning supplies, etc.<br/>department store - clothing, furniture, shoes, perfume, etc.<br/>outlet stores - large stores that get items directly from the company that makes them."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "jeans"}, {"type": "definition", "content": "very popular pants made of denim"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Do you like these jeans?"}, {"type": "audio", "content": "engenn2le07ob01aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when you shop for clothes."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "t-shirt"}, {"type": "definition", "content": "a shirt shaped like a T, with short sleeves"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'm going to try on this T-shirt with those jeans."}, {"type": "audio", "content": "engenn2le07ob01aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "casual wear"}, {"type": "definition", "content": "clothing for sports or recreation, not for work"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: This store has a good casual wear department."}, {"type": "audio", "content": "engenn2le07ob01aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "boots"}, {"type": "definition", "content": "protection for the feet for outdoor use"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  Do you like these boots?"}, {"type": "audio", "content": "engenn2le07ob01aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "leather"}, {"type": "definition", "content": "material originally from animals, used to make boots and coats"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: These boots are made of leather."}, {"type": "audio", "content": "engenn2le07ob01aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "sweatshirt"}, {"type": "definition", "content": "clothing for the upper body, often for sports"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  I'm going to try on this sweatshirt."}, {"type": "audio", "content": "engenn2le07ob01aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "hoodie"}, {"type": "definition", "content": "a sweatshirt with a part to cover the head"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Try this hoodie. It has a hood."}, {"type": "audio", "content": "engenn2le07ob01aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "outlet"}, {"type": "definition", "content": "a store that sells goods directly from the manufacturer"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'm going shopping at the new outlet store this afternoon."}, {"type": "audio", "content": "engenn2le07ob01aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mall"}, {"type": "definition", "content": "a building with many stores"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  I love the new mall!"}, {"type": "audio", "content": "engenn2le07ob01aud09"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "store"}, {"type": "definition", "content": "a place you buy things"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are many stores in this mall."}, {"type": "audio", "content": "engenn2le07ob01aud10"}]}, {"type": "background_image", "content": "engenn2le07ob01re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "With a partner, talk about shopping."}, {"type": "text", "content": "Think of 3 good things. Examples: <span class=\"italic\">new clothes</span>, <span class=\"italic\">fun</span>."}, {"type": "text", "content": "Think of 3 bad things. Examples: <span class=\"italic\">noisy</span>, <span class=\"italic\">crowded</span>"}, {"type": "text", "content": "Complete the table.